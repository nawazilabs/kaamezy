# Copy to .env (never commit .env)
SARVAM_API_KEY=
GEMINI_API_KEY=
CHAUKAS_DB_PATH=data/chaukas.db
CHAUKAS_REPLAY_MODE=off

# Consumer flows (health insurance + personal loan). The server checks the browser's Supabase sign-in token.
# Use the same Supabase project as the web app. The publishable key is the public client key, not a secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# supabase = require a valid sign-in (default when SUPABASE_URL is set) | off = local development only
CHAUKAS_CONSUMER_AUTH=
# Key for the agent-desk call that approves a human review. The demo falls back to "demo-staff": set your own when deployed.
CHAUKAS_STAFF_KEY=
